<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/catalogProductLink/:id" method="GET">
        <service class="Omnipro\QuickProductPositioning\Api\CategoryProductLinkRepositoryInterface" method="load"/>
        <resources>
            <resource ref="Omnipro_QuickProductPositioning::omnipro_product_positioning_read"/>
        </resources>
    </route>
    <route url="/V1/catalogProductLink" method="POST">
        <service class="Omnipro\QuickProductPositioning\Api\CategoryProductLinkRepositoryInterface" method="save"/>
        <resources>
            <resource ref="Omnipro_QuickProductPositioning::omnipro_product_positioning_write"/>
        </resources>
    </route>
    <route url="/V1/catalogProductLink/:id" method="DELETE">
        <service class="Omnipro\QuickProductPositioning\Api\CategoryProductLinkRepositoryInterface" method="delete"/>
        <resources>
            <resource ref="Omnipro_QuickProductPositioning::omnipro_product_positioning_write"/>
        </resources>
    </route>
    <route url="/V1/catalogProductLink/search" method="GET">
        <service class="Omnipro\QuickProductPositioning\Api\CategoryProductLinkRepositoryInterface" method="getList"/>
        <resources>
            <resource ref="Omnipro_QuickProductPositioning::omnipro_product_positioning_read"/>
        </resources>
    </route>
</routes>
